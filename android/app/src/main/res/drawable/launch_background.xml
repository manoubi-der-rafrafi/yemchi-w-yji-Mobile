<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch screen: orange brand background (#FF7A00 solid fallback) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid brand orange — gradients are not supported in layer-list on API < 23 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF7A00" />
        </shape>
    </item>
    <!-- Centered app icon in its white rounded card -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
